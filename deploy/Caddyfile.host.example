# Replace monitor.example.com with the domain whose A/AAAA records point to
# this server. The standalone process itself stays on 127.0.0.1:8787.
monitor.example.com {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
	}

	@firmware path /api/v1/display/firmware/e32r28t/manifest /api/v1/display/firmware/e32r28t/*.bin
	handle @firmware {
		# Stream OTA images instead of waiting for the complete response.
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
			transport http {
				read_timeout 5m
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8787
	}
}
