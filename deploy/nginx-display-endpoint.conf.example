# Display-only HTTPS endpoint. Replace the server name and certificate paths.
# Keep the Go service on loopback; do not expose port 8787 publicly.
#
# This file assumes the following request-rate zone exists in nginx's `http`
# context (for example in /etc/nginx/conf.d/quota-monitor-rate.conf):
#   limit_req_zone $binary_remote_addr zone=quota_monitor_display:1m rate=120r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name monitor.example.com;

    ssl_certificate /etc/letsencrypt/live/monitor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitor.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 64k;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /healthz {
        limit_except GET { deny all; }
        include snippets/quota-monitor-proxy.conf;
    }

    location = /api/v1/display/snapshot {
        limit_except GET { deny all; }
        limit_req zone=quota_monitor_display burst=10 nodelay;
        include snippets/quota-monitor-proxy.conf;
    }

    location = /api/v1/display/firmware/e32r28t/manifest {
        limit_except GET { deny all; }
        limit_req zone=quota_monitor_display burst=10 nodelay;
        include snippets/quota-monitor-proxy.conf;
    }

    location ~ ^/api/v1/display/firmware/e32r28t/(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.bin$ {
        limit_except GET { deny all; }
        limit_req zone=quota_monitor_display burst=10 nodelay;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 5m;
        send_timeout 5m;
        include snippets/quota-monitor-proxy.conf;
    }

    location / { return 404; }
}
